check_PROGRAMS = ast_cmd \
		 ast_if \
         ast_list \
         ast_pipe \
         ast_redir

ast_cmd_SOURCES =  \
    ast_cmd.c

ast_cmd_CPPFLAGS = -I$(top_srcdir)/src

ast_cmd_CFLAGS = -std=c99 -Werror -Wall -Wextra -Wvla

ast_cmd_LDADD =  \
    $(top_srcdir)/src/ast/libast.a

ast_cmd_LDFLAGS = -lcriterion

